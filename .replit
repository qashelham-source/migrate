modules = ["python-base-3.13"]

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8080
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "download"

[[workflows.workflow]]
name = "download"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python serve_zip.py"
